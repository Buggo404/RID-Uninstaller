# Database password; letters and digits only (it is placed inside a connection address).
RID_DB_PASSWORD=
# Token for the administrator requests (publishing rules and releases); 24+ characters.
RID_ADMIN_TOKEN=
# May carry an address to listen only for a reverse proxy on this machine, e.g. 127.0.0.1:18730
RID_PORT=8080
# Questions passed on to the model per 24 hours, over all clients.
AI_DAILY_LIMIT=3000

# The model behind /v1/ai/*. Leave AI_BASE_URL empty to switch the AI features off.
# AI_PROTOCOL: chat (OpenAI chat/completions), responses (OpenAI responses) or messages (Anthropic messages).
# AI_BASE_URL includes the version segment, e.g. https://api.example.com/v1
AI_PROTOCOL=chat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
